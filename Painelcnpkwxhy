-- ⚡ SPEED GLITCH
local function ApplyWeight(val)
    local char = LocalPlayer.Character
    if not char then return end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return end
    local old = char:FindFirstChild(State.Speed.WeightName)
    if old then old:Destroy() end
    if val > 0 then
        local w = Instance.new("Part")
        w.Name = State.Speed.WeightName
        w.Size = Vector3.new(1,1,1)
        w.Transparency = 1
        w.CanCollide = false
        w.Parent = char
        local weld = Instance.new("Weld")
        weld.Part0 = root
        weld.Part1 = w
        weld.C0 = CFrame.new(State.Speed.Offset)
        weld.Parent = w
        w.CustomPhysicalProperties = PhysicalProperties.new(val, 0.3, 0.5)
    end
end

