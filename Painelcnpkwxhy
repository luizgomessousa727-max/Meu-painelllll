-- 🏃 EMOTE SPEED
local itensBalao = {WaterBalloon2024=true,SnowballToy2020=true,IceCream=true}
local function aplicarSistemaSpeed(char)
    local hum = char:WaitForChild("Humanoid")
    local root = char:WaitForChild("HumanoidRootPart")
    if char:FindFirstChild("GlitchPart") then char.GlitchPart:Destroy() end
    local gp = Instance.new("Part")
    gp.Name = "GlitchPart"
    gp.Size = Vector3.new(2,2,2)
    gp.Transparency = 1 gp.CanCollide = false gp.Parent = char
    local w = Instance.new("Weld")
    w.Part0 = root w.Part1 = gp w.Parent = gp
    local function setOff(z) w.C0 = CFrame.new(0,0,z) end
    local emoteAtivo, efeito, off, tool, escada, espera, fim = nil, false, 0, nil, false, false, false
    local em = {["rbxassetid://15609995579"]="normal",["rbxassetid://107481557610007"]="forte"}
    local function ativar(z) efeito=true off=z setOff(z) end
    local function desativar() efeito=false escada=false off=0 espera=false fim=false setOff(0) end
    hum.AnimationPlayed:Connect(function(t)
        if t.Animation then local tipo = em[t.Animation.AnimationId]
            if tipo then emoteAtivo=tipo off=0 espera=false fim=false
                t.Stopped:Connect(function() emoteAtivo=nil espera=true fim=tool~=nil end)
            end
        end
    end)
    char.ChildRemoved:Connect(function(o)
        if itensBalao[o.Name] then
            if emoteAtivo=="normal" then off=10.5 elseif emoteAtivo=="forte" then off=25 end
            if efeito then setOff(off) end
        end
        if o:IsA("Tool") and o==tool then tool=nil if espera and fim then desativar() end end
    end)
    char.ChildAdded:Connect(function(o)
        if o:IsA("Tool") then
            tool=o
            if espera and not fim then desativar() return end
            if hum:GetState()==Enum.HumanoidStateType.Climbing then
                escada=true efeito=true setOff(3.5)
            elseif emoteAtivo=="normal" then ativar(off>0 and off or 7.5)
            elseif emoteAtivo=="forte" then ativar(off>0 and off or 10.5)
            end
        end
    end)
    task.spawn(function() while char.Parent and State.EmoteSpeed.Active do task.wait(0.05) if efeito then setOff(escada and 3.5 or off) end end end)
end
local function SetEmoteSpeed(ativo)
    State.EmoteSpeed.Active=ativo
    if ativo then
        if LocalPlayer.Character then aplicarSistemaSpeed(LocalPlayer.Character) end
        State.EmoteSpeed.CharConn=LocalPlayer.CharacterAdded:Connect(aplicarSistemaSpeed)
    else
        if State.EmoteSpeed.CharConn then State.EmoteSpeed.CharConn:Disconnect() end
        for _,v in ipairs(State.EmoteSpeed.Connections) do pcall(function() v:Disconnect() end) end
        table.clear(State.EmoteSpeed.Connections)
        if LocalPlayer.Character then local p=LocalPlayer.Character:FindFirstChild("GlitchPart") if p then p:Destroy() end end
    end
end

-- 🎯 MIRA BRANCA
local WHITE_CROSSHAIR = "rbxassetid://134918171998030"
local crosshairActive = false
local function atualizarMira(on) mouse.Icon = on and WHITE_CROSSHAIR or "" end
local function isArrow(o) return (o:IsA("TextLabel") or o:IsA("TextButton")) and (o.Text=="<" or o.Text==">") end
local function hideShift()
    local pg = LocalPlayer:FindFirstChildOfClass("PlayerGui") if not pg then return end
    for _,d in ipairs(pg:GetDescendants()) do
        if d:IsA("GuiObject") then local n=d.Name:lower() if n:find("shift") or n:find("mouse") or n:find("lock") then d.Visible=false end end
    end
end
local function hideArrow(a) local p=a.Parent for i=1,5 do if not p or not p:IsA("GuiObject") then break end local s=p.AbsoluteSize if s.X>=50 and s.X<=350 and s.Y>=50 and s.Y<=400 then p.Visible=false return true end p=p.Parent end if a:IsA("TextButton") then a.Visible=false return true end return false end
local function monitorTool(t) if not t:IsA("Tool") or t.Name~="Gun" or t:GetAttribute("CrosshairConectado") then return end t:SetAttribute("CrosshairConectado",true) t.Equipped:Connect(function() if crosshairActive then atualizarMira(true) end end) t.Unequipped:Connect(function() atualizarMira(false) end) end
local function SetCrosshair(ativo)
    crosshairActive=ativo
    if ativo then
        LocalPlayer.DevEnableMouseLock=true
        task.wait(1.5)
        hideShift()
        local pg = LocalPlayer:WaitForChild("PlayerGui")
        for _,d in ipairs(pg:GetDescendants()) do if isArrow(d) then hideArrow(d) end end
        State.Crosshair.Connections[#State.Crosshair.Connections+1]=pg.DescendantAdded:Connect(function(o) task.wait(0.15) if o:IsA("GuiObject") then local n=o.Name:lower() if n:find("shift") or n:find("mouse") or n:find("lock") then o.Visible=false end end if isArrow(o) then hideArrow(o) end end)
        local function setupChar(c) atualizarMira(false) for _,d in ipairs(c:GetChildren()) do monitorTool(d) end State.Crosshair.Connections[#State.Crosshair.Connections+1]=c.ChildAdded:Connect(monitorTool) local bp=LocalPlayer:WaitForChild("Backpack") for _,t in ipairs(bp:GetChildren()) do monitorTool(t) end State.Crosshair.Connections[#State.Crosshair.Connections+1]=bp.ChildAdded:Connect(monitorTool) end
        if LocalPlayer.Character then task.spawn(setupChar,LocalPlayer.Character) end
        State.Crosshair.CharConn=LocalPlayer.CharacterAdded:Connect(setupChar)
    else
        atualizarMira(false)
        if State.Crosshair.CharConn then State.Crosshair.CharConn:Disconnect() State.Crosshair.CharConn=nil end
        for _,v in ipairs(State.Crosshair.Connections) do pcall(function() v:Disconnect() end) end
        table.clear(State.Crosshair.Connections)
    end
end

