-- 🔫 SISTEMA ARMA
local function SetGunSystem(ativo)
    if ativo then
        local SOUND_ID = "rbxassetid://6968135315"
        local TARGET_TOOL_NAME = "Gun"
        local COOLDOWN_DURATION = 2
        local enabled = true
        local actionSound = Instance.new("Sound")
        actionSound.SoundId = SOUND_ID
        actionSound.Volume = 1
        actionSound.Parent = SoundService
        State.Gun.Sound = actionSound
        local function setupGunSystem(character)
            local humanoid = character:WaitForChild("Humanoid", 10)
            local animator = humanoid and humanoid:WaitForChild("Animator", 10)
            local lastUnequippedTime = 0
            if animator then
                State.Gun.Connections.Anim = animator.AnimationPlayed:Connect(function(track)
                    if not enabled then return end
                    local tool = character:FindFirstChildOfClass("Tool")
                    local isHoldingGun = (tool and tool.Name == TARGET_TOOL_NAME)
                    local timeSinceUnequip = os.clock() - lastUnequippedTime
                    if (isHoldingGun or timeSinceUnequip <= COOLDOWN_DURATION) and track.Priority == Enum.AnimationPriority.Action then
                        track:Stop()
                    end
                end)
            end
            State.Gun.Connections.Add = character.ChildAdded:Connect(function(child)
                if child:IsA("Tool") and child.Name == TARGET_TOOL_NAME then actionSound:Play() end
            end)
            State.Gun.Connections.Remove = character.ChildRemoved:Connect(function(child)
                if child:IsA("Tool") and child.Name == TARGET_TOOL_NAME then
                    actionSound:Play()
                    lastUnequippedTime = os.clock()
                end
            end)
        end
        if LocalPlayer.Character then setupGunSystem(LocalPlayer.Character) end
        State.Gun.Connections.Char = LocalPlayer.CharacterAdded:Connect(setupGunSystem)
    else
        for _, v in pairs(State.Gun.Connections) do if v then v:Disconnect() end end
        State.Gun.Connections = {}
        if State.Gun.Sound then State.Gun.Sound:Destroy() end
    end
end

-- 🦵 KORBLOX
local korbloxBielConnections = {}
local function applyKorbloxBiel()
    local char = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
    local hum = char:WaitForChild("Humanoid", 5)
    if not hum or char:FindFirstChild("KorbloxFolder") then return end
    local folder = Instance.new("Folder")
    folder.Name = "KorbloxFolder"
    folder.Parent = char
    if hum.RigType == Enum.HumanoidRigType.R15 then
        local ru = char:WaitForChild("RightUpperLeg", 3)
        local rl = char:WaitForChild("RightLowerLeg", 3)
        local rf = char:WaitForChild("RightFoot", 3)
        ru.Transparency = 1 rl.Transparency = 1 rf.Transparency = 1
        local p = Instance.new("Part")
        p.Name = "KorbloxR15Visual"
        p.Size = Vector3.new(1, 2, 1)
        p.Transparency = 1 p.CanCollide = false p.Massless = true p.Parent = folder
        local m = Instance.new("SpecialMesh")
        m.MeshId = "rbxassetid://902942096"
        m.TextureId = "rbxassetid://902843398"
        m.Scale = Vector3.new(1,1,1) m.Parent = p
        local w = Instance.new("Weld")
        w.Part0 = ru w.Part1 = p w.C0 = CFrame.new(0.1, 0.2, 0) w.Parent = p
    elseif hum.RigType == Enum.HumanoidRigType.R6 then
        local rl = char:WaitForChild("Right Leg", 3)
        for _, v in ipairs(char:GetChildren()) do if v:IsA("CharacterMesh") and v.BodyPart == Enum.BodyPart.RightLeg then v:Destroy() end end
        rl.Transparency = 1
        local p = Instance.new("Part")
        p.Name = "KorbloxR6Visual"
        p.Size = Vector3.new(1, 2, 1)
        p.Transparency = 1 p.CanCollide = false p.Massless = true p.Parent = folder
        local m = Instance.new("SpecialMesh")
        m.MeshType = Enum.MeshType.FileMesh
        m.MeshId = "rbxassetid://101851696"
        m.TextureId = "rbxassetid://101851254"
        m.Scale = Vector3.new(1,1,1) m.Parent = p
        local w = Instance.new("Weld")
        w.Part0 = rl w.Part1 = p w.C0 = CFrame.new(0,0,0) w.Parent = p
    end
end
local function SetKorblox(ativo)
    if ativo then
        if LocalPlayer.Character then task.spawn(applyKorbloxBiel) end
        table.insert(korbloxBielConnections, LocalPlayer.CharacterAdded:Connect(function() task.wait(0.5) applyKorbloxBiel() end))
    else
        for _, v in ipairs(korbloxBielConnections) do pcall(function() v:Disconnect() end) end
        table.clear(korbloxBielConnections)
        local char = LocalPlayer.Character
        if char then
            if char:FindFirstChild("KorbloxFolder") then char.KorbloxFolder:Destroy() end
            local hum = char:FindFirstChild("Humanoid")
            if hum then
                if hum.RigType == Enum.HumanoidRigType.R15 then
                    for _, n in ipairs({"RightUpperLeg","RightLowerLeg","RightFoot"}) do
                        local p = char:FindFirstChild(n) if p then p.Transparency = 0 end
                    end
                elseif hum.RigType == Enum.HumanoidRigType.R6 then
                    local rl = char:FindFirstChild("Right Leg") if rl then rl.Transparency = 0 end
                end
            end
        end
    end
end

-- 😶‍🌫️ HEADLESS
local function setHeadless(char, state)
    local head = char:FindFirstChild("Head")
    if head then
        head.Transparency = state and 1 or 0
        local face = head:FindFirstChild("face")
        if face then face.Transparency = state and 1 or 0 end
    end
end

